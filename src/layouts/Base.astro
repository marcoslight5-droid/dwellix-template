---
import { fontFaceCss, preloadFonts } from '../lib/fonts';
import '../styles/global.css';

import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { type Lang, dirOf, otherLang, ui, t, homePath } from '../lib/i18n';
import { agent, listings, PREVIEW, ACCENT, accentInk, agentPhoto, listingImages } from '../lib/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path after the language prefix, e.g. "" or "listings/abc/". */
  path: string;
  ogImage?: ImageMetadata;
}

const { lang, title, description, path, ogImage } = Astro.props;
const s = ui(lang);
const alt = otherLang(lang);
const site = Astro.site!;
const urlFor = (l: Lang) => new URL(`/${l}/${path}`, site).href;

const ogSource = ogImage ?? (await listingImages(listings[0].id))[0];
const og = await getImage({ src: ogSource, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, site).href;
const photo = await getImage({ src: await agentPhoto(), width: 600, format: 'jpg' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  '@id': new URL('/#agent', site).href,
  name: t(agent.name, lang),
  alternateName: t(agent.name, alt),
  image: new URL(photo.src, site).href,
  url: urlFor(lang),
  telephone: agent.whatsapp,
  ...(agent.email ? { email: agent.email } : {}),
  description: t(agent.bio, lang),
  areaServed: [...new Set(listings.map((l) => t(l.area, lang)))].map((name) => ({ '@type': 'Place', name })),
  knowsLanguage: agent.languages,
  identifier: { '@type': 'PropertyValue', name: 'RERA BRN', value: agent.brn },
  parentOrganization: { '@type': 'RealEstateAgent', name: t(agent.agency, lang) },
  address: { '@type': 'PostalAddress', addressLocality: 'Dubai', addressCountry: 'AE' },
};
const accentStyle = `--accent:${ACCENT};--accent-ink:${accentInk(ACCENT)}`;
---

<!doctype html>
<html lang={lang} dir={dirOf(lang)} style={accentStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {preloadFonts(lang).map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <title>{title}</title>
    <meta name="description" content={description} />
    {PREVIEW && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={urlFor(lang)} />
    <link rel="alternate" hreflang="en" href={urlFor('en')} />
    <link rel="alternate" hreflang="ar" href={urlFor('ar')} />
    <link rel="alternate" hreflang="x-default" href={urlFor('en')} />
    <meta name="theme-color" content="#faf8f5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${t(agent.name, lang)} · ${t(agent.agency, lang)}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlFor(lang)} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AE' : 'en_AE'} />
    <meta property="og:locale:alternate" content={alt === 'ar' ? 'ar_AE' : 'en_AE'} />
    <meta name="twitter:card" content="summary_large_image" />

    <style is:inline set:html={fontFaceCss}></style>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'ar' ? 'تخطّ إلى المحتوى' : 'Skip to content'}</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={homePath(lang)}>
          <span class="brand-name">{t(agent.name, lang)}</span>
          <span class="brand-agency">{t(agent.agency, lang)}</span>
        </a>
        <a class="lang-toggle" href={`/${alt}/${path}`} hreflang={alt} lang={alt} aria-label={s.switchLabel} data-lang-toggle>
          {s.switchTo}
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>
          © {new Date().getFullYear()} {t(agent.name, lang)} · {t(agent.agency, lang)} · <span class="nowrap">{s.brnLong} <bdi>{agent.brn}</bdi></span>
        </p>
        {PREVIEW && <p class="preview-note">{s.previewBy}</p>}
      </div>
    </footer>

    <script>
      // Keep the scroll target (e.g. #listings) when switching language.
      const toggle = document.querySelector<HTMLAnchorElement>('[data-lang-toggle]');
      toggle?.addEventListener('click', () => {
        if (location.hash) toggle.href = toggle.href.split('#')[0] + location.hash;
      });
    </script>
  </body>
</html>
